#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
    hold-while-undecided;
};

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
    hold-while-undecided;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    behaviors {
        mouce_and_layer: mouce_and_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUCE_AND_LAYER";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none             &none             &none         &none              &none               &none                                            &none        &none  &none     &none                   &none             &none
&kp TAB           &kp Q             &kp W         &kp E              &kp R               &kp T                                            &kp Y        &kp U  &kp I     &kp O                   &kp P             &kp BSPC
&kp LEFT_CONTROL  &kp A             &kp S         &kp D              &kp F               &kp G        &none        &none                  &kp H        &kp J  &kp K     &kp L                   &kp SEMI          &kp ENTER
&kp LSHFT         &kp Z             &kp X         &kp C              &kp V               &kp B        &kp SPACE    &kp RET                &kp N        &kp M  &mkp MB1  &mouce_and_layer 5 MB2  &kp RIGHT_SHIFT   &kp RSHFT
&kp ESC           &kp LS(LEFT_ALT)  &kp LEFT_ALT  &kp RIGHT_CONTROL  &mt LEFT_WIN LANG2  &lt 3 LANG2  &lt 2 SPACE  &mt RSHIFT LANGUAGE_2  &lt 3 ENTER  &none  &none     &kp LG(SPACE)           &kp LC(UP_ARROW)  &kp LC(UP_ARROW)
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans                    &trans                      &trans                &trans             &trans                             &trans     &trans        &trans        &trans        &trans      &trans
&trans  &kp LS(LG(F18))           &kp LS(LG(LEFT))            &kp LS(LG(UP_ARROW))  &kp LS(LG(RIGHT))  &kp LS(LG(F19))                    &kp PLUS   &kp N7        &kp N8        &kp N9        &kp SPACE   &trans
&trans  &kp LA(LG(LS(UP_ARROW)))  &kp LA(LG(LS(RIGHT)))       &kp N3                &kp N4             &kp LS(LA(LG(L)))  &none   &trans  &kp MINUS  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON   &trans
&trans  &kp LA(LG(LS(LEFT)))      &kp LA(LS(LG(DOWN_ARROW)))  &kp N8                &kp N9             &kp N0             &trans  &trans  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0      &trans
&trans  &trans                    &trans                      &trans                &trans             &trans             &trans  &trans  &trans     &none         &none         &kp COMMA     &kp PERIOD  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
