#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
    hold-while-undecided;
};

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
    hold-while-undecided;
};

&trackball_listener {
    /* 通常時はカーソル移動のまま（必要なら速度調整も可） */
    /* input-processors = <&zip_xy_scaler 3 2>; */

    scroller {
        /* ↓ ここを「スクロールレイヤー番号」に合わせる */

        layers = <5>;
        input-processors = <
      &zip_xy_to_scroll_mapper
      &zip_xy_scaler 1 16
      /* スクロール速度を上げたいなら倍率を足す例（任意） */
      /* &zip_scroll_scaler 1 3 */
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        layer6 {
            bindings = <&mo 6>;
            key-positions = <53 52>;
        };
    };

    behaviors {
        mouce_and_layer: mouce_and_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUCE_AND_LAYER";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        text: text {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp I &kp J &kp U &kp M &kp O &kp N8 &kp N0 &kp UNDER>;
            label = "TEXT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none             &none             &none         &none              &none               &none                                    &none             &none  &none     &none                   &none             &none
&kp TAB           &kp Q             &kp W         &kp E              &kp R               &kp T                                    &kp Y             &kp U  &kp I     &kp O                   &kp P             &kp BSPC
&kp LEFT_CONTROL  &kp A             &kp S         &kp D              &kp F               &kp G        &none        &none          &kp H             &kp J  &kp K     &kp L                   &mo 3             &kp ENTER
&kp LSHFT         &kp Z             &kp X         &kp C              &kp V               &kp B        &kp SPACE    &kp BACKSPACE  &kp N             &kp M  &mkp MB1  &mouce_and_layer 5 MB2  &kp RIGHT_SHIFT   &kp RSHFT
&kp ESC           &kp LS(LEFT_ALT)  &kp LEFT_ALT  &kp RIGHT_CONTROL  &mt LEFT_WIN LANG2  &lt 3 LANG2  &lt 2 SPACE  &lt 2 ENTER    &lt 4 LANGUAGE_1  &none  &none     &kp LG(SPACE)           &kp LC(UP_ARROW)  &kp LC(UP_ARROW)
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans                    &trans                      &trans                &trans                 &trans                                          &trans     &trans        &trans        &trans        &trans      &trans
&trans  &kp LS(LG(F18))           &kp LS(LG(LEFT))            &kp LS(LG(UP_ARROW))  &kp LS(LG(RIGHT))      &kp LS(LG(F19))                                 &kp PLUS   &kp N7        &kp N8        &kp N9        &kp SPACE   &trans
&trans  &kp LA(LG(LS(UP_ARROW)))  &kp LA(LG(LS(RIGHT)))       &kp LG(LS(LA(LEFT)))  &kp LG(LS(LA(RIGHT)))  &kp LS(LA(LG(L)))  &none                &trans  &kp MINUS  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON   &trans
&trans  &kp LA(LG(LS(LEFT)))      &kp LA(LS(LG(DOWN_ARROW)))  &trans                &trans                 &kp LS(LA(LG(L)))  &kp LG(LS(LA(F18)))  &trans  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0      &trans
&trans  &trans                    &trans                      &trans                &trans                 &trans             &trans               &trans  &trans     &none         &none         &kp COMMA     &kp PERIOD  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans   &trans          &trans  &trans     &trans         &trans                         &trans  &trans          &trans          &trans         &trans  &trans
&kp ESC  &trans          &trans  &trans     &trans         &kp LS(LG(T))                  &trans  &kp LA(LEFT)    &kp UP_ARROW    &kp LA(RIGHT)  &trans  &trans
&trans   &kp LG(LS(F6))  &trans  &trans     &trans         &text          &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &trans  &trans
&trans   &trans          &trans  &kp LG(C)  &kp LG(LS(V))  &trans         &trans  &trans  &trans  &trans          &kp END         &trans         &trans  &trans
&trans   &trans          &trans  &trans     &trans         &trans         &trans  &trans  &trans  &trans          &trans          &trans         &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans       &trans      &trans           &trans     &trans                                  &trans             &trans                &trans                 &trans          &trans                &trans
&trans  &kp PERCENT  &kp DOLLAR  &kp AMPERSAND    &kp SLASH  &kp NON_US_BACKSLASH                    &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE       &trans
&trans  &kp AT_SIGN  &kp HASH    &kp EXCLAMATION  &kp MINUS  &kp EQUAL             &trans  &trans    &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON   &kp COLON             &trans
&trans  &kp CARET    &kp TILDE   &kp QUESTION     &kp PLUS   &kp ASTERISK          &trans  &kp PIPE  &kp LESS_THAN      &kp GREATER_THAN      &kp COMMA              &kp PERIOD      &kp UNDERSCORE        &trans
&trans  &trans       &trans      &trans           &trans     &kp LG(F6)            &trans  &trans    &trans             &trans                &trans                 &kp GRAVE       &kp LG(LS(NUMBER_4))  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &trans         &trans                &trans                 &trans  &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                         &kp LG(TILDE)  &kp LG(LA(LEFT))      &kp LA(LG(RIGHT))      &trans  &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &kp LA(PLUS)   &kp LA(LG(LEFT))      &kp LG(LA(RIGHT))      &trans  &kp RIGHT_ALT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &kp LG(MINUS)  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans  &kp RIGHT_ALT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LS(R))  &kp LG(LS(W))  &trans                &trans                 &trans  &trans         &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
